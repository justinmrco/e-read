PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/e-read
FRONTEND_URL=http://localhost:3001
# Generate locally with node:crypto randomBytes(32).toString('hex')
JWT_SECRET=
# Outbound Midtrans API authentication (sandbox Server Key)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Incoming webhook SHA512 verification only. Standard Snap uses the merchant Server Key here too.
# Keep an explicit override only if verified against your actual payment notifications.
MIDTRANS_SIGNATURE_KEY=

# Temporary signature diagnostics; never enable for routine operation
MIDTRANS_WEBHOOK_DEBUG=false
